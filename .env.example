# Telegram BotFather token. Never commit the real value.
BOT_TOKEN=replace_with_bot_token

# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_api_hash

# Your numeric Telegram user ID. Only this account can control the bot.
OWNER_TELEGRAM_ID=123456789

# Optional application settings
LOG_LEVEL=INFO
# Fixed at 1: every source shares one serial download worker.
MAX_CONCURRENT_DOWNLOADS=1
